# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 처리되어 커밋되지 않습니다)

# Supabase 대시보드 > Project Settings > API Keys 의 service_role(또는 sb_secret_...) 키. 절대 클라이언트·저장소에 두지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 선택: 기본값은 stylebox 프로젝트 / 토스페이먼츠 문서용 공개 테스트 키
# SUPABASE_URL=https://iftcupnhdudjovfbjcnk.supabase.co
# SUPABASE_ANON_KEY=
# TOSS_SECRET_KEY=
# PORT=5500
